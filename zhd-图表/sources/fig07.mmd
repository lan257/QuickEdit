---
title: 图7 敏感字段识别与策略模块流程图
---
flowchart TB
  s(["开始"])
  io1[/"输入表头与样本行"/]
  p1["按标准表头匹配字段角色"]
  d1{"表头未命中？"}
  p2["按值特征与词库匹配<br>列名/正则/样本值"]
  p3["输出字段类型清单<br>账号/金额/时间/地点等"]
  io2[/"用户选择脱敏策略"/]
  p4["保留格式 / 掩码 /<br>替换 / 删除"]
  d2{"需要密钥？"}
  p5["校验密钥与词库设置"]
  p6["生成字段策略表 FieldPolicy"]
  t1[("保存策略与词库配置")]
  e(["返回策略结果"])
  s --> io1
  io1 --> p1
  p1 --> d1
  d1 -->|是| p2
  p2 --> p3
  d1 -->|否| p3
  p3 --> io2
  io2 -.->|可选策略| p4
  io2 --> d2
  d2 -->|是| p5
  p5 --> p6
  d2 -->|否| p6
  p6 --> t1
  t1 --> e
