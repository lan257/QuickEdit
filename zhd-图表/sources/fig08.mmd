---
title: 图8 本地脱敏执行和 Vault 模块流程图
---
flowchart TB
  s(["开始"])
  p1["只读逐行读取源文件"]
  p2["按 FieldPolicy 定位敏感列"]
  d1{"命中敏感值？"}
  p3["原样写入输出行"]
  d2{"Vault 已有映射？"}
  p4["复用既有脱敏值<br>保证一致性"]
  p5["按策略生成脱敏值"]
  p6[("原值↔脱敏值写入 Vault<br>（任务级保护信息）")]
  p7("写出脱敏输出文件（新文件）")
  d3{"源文件被修改？"}
  nt["约束：源文件全程只读，<br>输出文件独立生成"]
  p8[("记录操作日志与审计日志")]
  io1[/"输出脱敏结果统计"/]
  e(["结束"])
  s --> p1
  p1 --> p2
  p2 --> d1
  d1 -->|否| p3
  p3 --> p7
  d1 -->|是| d2
  d2 -->|是| p4
  p4 --> p7
  d2 -->|否| p5
  p5 --> p6
  p6 --> p7
  p7 --> d3
  d3 -.-> nt
  d3 -->|否（保持只读）| p8
  p8 --> io1
  io1 --> e
