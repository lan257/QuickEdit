---
title: 图2 CSV行为分析与脱敏协同流程图（系统主流程）
---
flowchart TB
  s(["开始"])
  lic[["校验离线授权 run.kh"]]
  ok{"授权有效？"}
  halt(["提示授权无效并退出"])
  main["进入主界面并加载导航"]
  pick[/"选择 CSV 数据文件"/]
  head["解析表头并映射字段角色"]
  miss{"关键角色齐备？"}
  map[/"人工指定列语义"/]
  row["构建 StructuredRow"]
  evt["构建 BehaviorEvent"]
  bad{"存在解析失败行？"}
  raw["保留原文 RawAmount /<br>RawDirection / RawTimeText"]
  idx["生成 BehaviorIndex 与 BehaviorGraph"]
  rule[["执行 R001~R006 规则评估"]]
  ca(("A"))
  ca2(("A"))
  hit{"命中 Finding？"}
  only["仅更新概览与统计"]
  find["生成 Finding 与证据回溯定位"]
  view["更新概览/明细/关系图/报告"]
  need{"需要脱敏输出？"}
  rec["敏感字段识别与策略选择"]
  run["执行脱敏并写入 Vault"]
  out("生成脱敏输出文件")
  log[("记录审计日志/操作日志/任务")]
  e(["结束"])
  s --> lic
  lic --> ok
  ok -->|否| halt
  ok -->|是| main
  main --> pick
  pick --> head
  head --> miss
  miss -->|否| map
  map -.->|重新映射| head
  miss -->|是| row
  row --> evt
  evt --> bad
  bad -->|是（不丢弃）| raw
  raw --> idx
  bad -->|否| idx
  idx --> rule
  rule --> ca
  ca2 --> hit
  hit -->|否| only
  only --> view
  hit -->|是| find
  find --> view
  view --> need
  need -->|否| log
  need -->|是| rec
  rec --> run
  run --> out
  out --> log
  log --> e
