---
title: 图6 文件选择和批次管理模块流程图
---
flowchart TB
  s(["开始"])
  p1["用户点击“打开 CSV”"]
  io1[/"弹出文件选择对话框"/]
  d1{"已选择文件？"}
  cancel(["取消并返回主界面"])
  p2["以只读方式打开文件流"]
  d2{"打开成功？"}
  err[/"提示不可读或被占用"/]
  p3["探测编码与 BOM<br>UTF-8 / GBK / UTF-16"]
  p4["读取首行并解析表头"]
  d3{"该文件已有批次？"}
  reuse["复用 SourceId<br>并定位到既有视图"]
  p5["分配批次 SourceId<br>统计行数与列数"]
  t1[("登记任务与批次状态")]
  e(["返回分析上下文"])
  s --> p1
  p1 --> io1
  io1 --> d1
  d1 -->|否| cancel
  d1 -->|是| p2
  p2 --> d2
  d2 -->|否| err
  err -.->|重新选择| io1
  d2 -->|是| p3
  p3 --> p4
  p4 --> d3
  d3 -->|是| reuse
  reuse --> e
  d3 -->|否| p5
  p5 --> t1
  t1 --> e
